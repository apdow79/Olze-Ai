# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never in client bundle
SUPABASE_ANON_KEY also needed by web app as NEXT_PUBLIC_SUPABASE_ANON_KEY

# ── Olze AI Gateway (all OPTIONAL — free-first works without any of them) ──
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434            # optional local AI, never required

# Free-tier routing chain (comma-separated model refs)
OLZE_FREE_CHAIN=groq/llama-3.3-70b-versatile,openrouter/meta-llama/llama-3.3-70b-instruct:free,gemini/gemini-2.0-flash
OLZE_FREE_REQUESTS_PER_MONTH=100

# ── OAuth integrations ────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VERCEL_API_TOKEN=                                  # or use Vercel OAuth later
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=

# ── Server ────────────────────────────────────────────────
API_PORT=8787
WEB_ORIGIN=http://localhost:3000
PREVIEW_DOMAIN=preview.olze.app
SECRETS_ENCRYPTION_KEY=32-bytes-base64-master-key  # token vault (KMS in production)
JWT_AUDIENCE=authenticated
